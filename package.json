{
  "name": "amdox-erp-suite",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "clean": "turbo clean",
    "load-test": "k6 run k6-load-test.js",
    "infra:up": "docker compose up -d",
    "stack:up": "docker compose --profile app up -d --build"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.9.12",
    "typescript": "^5.4.5"
  },
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  }
}
