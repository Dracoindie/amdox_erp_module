# AMX-ERP-2026 web — copy to apps/web/.env.local

# Where the browser reaches the API (baked in at build time; also added to the CSP connect-src)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Static demo: answer API calls with Mock Service Worker instead of a real API
NEXT_PUBLIC_USE_MOCKS=false

# Extra space-separated origins allowed in the CSP connect-src (optional)
# CSP_CONNECT_SRC=
