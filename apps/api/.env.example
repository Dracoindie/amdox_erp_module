# AMX-ERP-2026 — API environment
# Copy to apps/api/.env and fill in values. NEVER commit .env.
# The API validates these on startup (src/config/env.ts) and refuses to boot
# if a required value is missing or too weak.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Express "trust proxy": false | true | <hop count> | <subnet>. Use 1 behind one reverse proxy.
TRUST_PROXY=false

# ── Database (docker compose exposes Postgres on 127.0.0.1:5432) ─────────────
DATABASE_URL="postgresql://amdox:amdox_dev_password@localhost:5432/amdox_erp"

# ── JWT (REQUIRED: two different random values, 32+ chars each) ──────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# ── CORS: comma-separated browser origins allowed to call the API ────────────
CORS_ORIGINS="http://localhost:3000"
# Cookies get the Secure flag automatically when NODE_ENV=production.
# COOKIE_SECURE=true

# ── Rate limits (requests per 15 minutes per IP) ─────────────────────────────
GLOBAL_RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=60

# ── ML forecasting service ───────────────────────────────────────────────────
ML_SERVICE_URL="http://localhost:8000"
# Shared secret sent as X-Internal-Token; must match the ml-service value (16+ chars).
ML_INTERNAL_TOKEN=""
ML_TIMEOUT_MS=10000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PRISMA_LOG_QUERIES=false
