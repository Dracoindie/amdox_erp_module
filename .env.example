# docker compose settings — copy to .env (gitignored) and fill in.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

POSTGRES_USER=amdox
POSTGRES_PASSWORD=
POSTGRES_DB=amdox_erp

# Two different values, 32+ characters each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shared secret between the API and the ML service (16+ characters)
ML_INTERNAL_TOKEN=

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: passwords used by the demo seed (defaults: Admin@1234 / Demo@1234)
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
